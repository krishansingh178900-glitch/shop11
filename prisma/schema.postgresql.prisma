// Prisma Schema for Smart Retail Assistant
// Supports SQLite for zero-config local reliability and PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  directUrl = env("DIRECT_URL")
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  phone        String?
  passwordHash String
  role         String       @default("OWNER") // OWNER, CASHIER, MANAGER
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  
  shopMembers  ShopMember[]
  auditLogs    AuditLog[]
  sales        Sale[]       @relation("CashierSales")
}

model Shop {
  id                     String      @id @default(cuid())
  name                   String
  ownerName              String
  email                  String
  phone                  String?
  category               String      @default("Grocery") // Grocery, Supermarket, Pharmacy, Stationery, Electronics, Clothing, Other
  address                String?
  currency               String      @default("₹")
  taxRatePercent         Float       @default(0.0)
  invoicePrefix          String      @default("INV-")
  alertExpiryDays        Int         @default(30)
  alertLowStockThreshold Int         @default(10)
  language               String      @default("en") // "en" | "hi"
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  members                ShopMember[]
  categories             ProductCategory[]
  products               Product[]
  batches                InventoryBatch[]
  movements              InventoryMovement[]
  suppliers              Supplier[]
  stockReceipts          StockReceipt[]
  sales                  Sale[]
  returns                Return[]
  purchaseOrders         PurchaseOrder[]
  notifications          Notification[]
  auditLogs              AuditLog[]
}

model ShopMember {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  role      String   @default("OWNER") // OWNER, CASHIER, STAFF
  createdAt DateTime @default(now())

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
}

model ProductCategory {
  id          String    @id @default(cuid())
  shopId      String
  name        String
  description String?
  createdAt   DateTime  @default(now())

  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([shopId, name])
}

model Product {
  id                String             @id @default(cuid())
  shopId            String
  name              String
  barcode           String?
  sku               String?
  categoryId        String?
  brand             String?
  unit              String             @default("pcs") // pcs, kg, g, ltr, ml, packet, box, strip
  minStockThreshold Int                @default(10)
  purchasePrice     Float              @default(0.0) // default/latest
  sellingPrice      Float              @default(0.0) // default selling price
  hasExpiry         Boolean            @default(true)
  imageUrl          String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category          ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches           InventoryBatch[]
  movements         InventoryMovement[]
  saleItems         SaleItem[]
  receiptItems      StockReceiptItem[]
  poItems           PurchaseOrderItem[]
  returnItems       ReturnItem[]
  notifications     Notification[]

  @@index([shopId, barcode])
  @@index([shopId, name])
}

model InventoryBatch {
  id               String                    @id @default(cuid())
  shopId           String
  productId        String
  batchNumber      String
  quantityReceived Float
  currentQuantity  Float
  purchasePrice    Float
  sellingPrice     Float
  mfgDate          DateTime?
  expiryDate       DateTime?
  supplierId       String?
  isExpired        Boolean                   @default(false)
  isWasted         Boolean                   @default(false)
  qrCodeData       String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  shop             Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product          Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier         Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  allocations      SaleItemBatchAllocation[]
  movements        InventoryMovement[]
  receiptItems     StockReceiptItem[]
  returnItems      ReturnItem[]
  notifications    Notification[]

  @@index([shopId, productId])
  @@index([shopId, expiryDate])
  @@index([shopId, currentQuantity])
}

model InventoryMovement {
  id              String          @id @default(cuid())
  shopId          String
  productId       String
  batchId         String?
  type            String          // PURCHASE, SALE, RETURN, WASTAGE, ADJUSTMENT
  quantity        Float           // positive for incoming, negative for outgoing
  unitCost        Float?
  unitPrice       Float?
  reason          String?
  referenceId     String?         // saleId, receiptId, returnId
  createdByUserId String?
  createdAt       DateTime        @default(now())

  shop            Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch           InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([shopId, productId])
  @@index([shopId, type])
  @@index([shopId, createdAt])
}

model Supplier {
  id             String          @id @default(cuid())
  shopId         String
  name           String
  phone          String?
  email          String?
  address        String?
  leadTimeDays   Int             @default(3)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  batches        InventoryBatch[]
  receipts       StockReceipt[]
  purchaseOrders PurchaseOrder[]

  @@index([shopId, name])
}

model StockReceipt {
  id            String             @id @default(cuid())
  shopId        String
  supplierId    String?
  receiptNumber String
  invoiceNumber String?
  totalCost     Float              @default(0.0)
  notes         String?
  receivedAt    DateTime           @default(now())
  createdAt     DateTime           @default(now())

  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier      Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items         StockReceiptItem[]

  @@index([shopId, receiptNumber])
}

model StockReceiptItem {
  id            String          @id @default(cuid())
  receiptId     String
  productId     String
  batchId       String?
  quantity      Float
  purchasePrice Float
  totalCost     Float

  receipt       StockReceipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch         InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
}

model Sale {
  id              String     @id @default(cuid())
  shopId          String
  invoiceNumber   String     @unique
  customerName    String?
  customerPhone   String?
  subtotal        Float
  discountAmount  Float      @default(0.0)
  discountPercent Float      @default(0.0)
  taxAmount       Float      @default(0.0)
  taxPercent      Float      @default(0.0)
  grandTotal      Float
  totalCost       Float      @default(0.0)
  grossProfit     Float      @default(0.0)
  paymentMethod   String     @default("CASH") // CASH, UPI, CARD, SPLIT
  paymentStatus   String     @default("PAID") // PAID, PARTIAL, REFUNDED
  upiReference    String?
  notes           String?
  cashierId       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  shop            Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cashier         User?      @relation("CashierSales", fields: [cashierId], references: [id], onDelete: SetNull)
  items           SaleItem[]
  payments        Payment[]
  returns         Return[]

  @@index([shopId, createdAt])
  @@index([shopId, invoiceNumber])
}

model SaleItem {
  id          String                    @id @default(cuid())
  saleId      String
  productId   String
  productName String
  quantity    Float
  unitPrice   Float
  totalAmount Float
  unitCost    Float                     @default(0.0)
  grossProfit Float                     @default(0.0)

  sale        Sale                      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  allocations SaleItemBatchAllocation[]
  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model SaleItemBatchAllocation {
  id         String         @id @default(cuid())
  saleItemId String
  batchId    String
  quantity   Float
  unitCost   Float          @default(0.0)
  unitPrice  Float          @default(0.0)

  saleItem   SaleItem       @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  batch      InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([saleItemId])
  @@index([batchId])
}

model Payment {
  id            String   @id @default(cuid())
  saleId        String
  amount        Float
  paymentMethod String   @default("CASH")
  reference     String?
  createdAt     DateTime @default(now())

  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Return {
  id                String       @id @default(cuid())
  shopId            String
  saleId            String
  returnNumber      String       @unique
  returnReason      String?
  totalRefundAmount Float        @default(0.0)
  status            String       @default("COMPLETED")
  createdAt         DateTime     @default(now())

  shop              Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sale              Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items             ReturnItem[]

  @@index([shopId, createdAt])
}

model ReturnItem {
  id               String          @id @default(cuid())
  returnId         String
  saleItemId       String
  productId        String
  batchId          String?
  quantity         Float
  refundAmount     Float
  restockInventory Boolean         @default(true)

  returnRecord     Return          @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem         SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch            InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
}

model PurchaseOrder {
  id                  String              @id @default(cuid())
  shopId              String
  supplierId          String?
  poNumber            String              @unique
  status              String              @default("DRAFT") // DRAFT, ORDERED, RECEIVED, CANCELLED
  totalEstimatedCost  Float               @default(0.0)
  notes               String?
  expectedDeliveryDate DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  shop                Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier            Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items               PurchaseOrderItem[]

  @@index([shopId, poNumber])
}

model PurchaseOrderItem {
  id                String        @id @default(cuid())
  poId              String
  productId         String
  quantity          Float
  estimatedUnitCost Float
  totalCost         Float

  po                PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Notification {
  id               String          @id @default(cuid())
  shopId           String
  type             String          // LOW_STOCK, OUT_OF_STOCK, EXPIRING_SOON, EXPIRED, REORDER_RECOMMENDED, DAILY_REPORT
  priority         String          @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  title            String
  message          String
  relatedProductId String?
  relatedBatchId   String?
  isRead           Boolean         @default(false)
  link             String?
  createdAt        DateTime        @default(now())

  shop             Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [relatedProductId], references: [id], onDelete: Cascade)
  batch            InventoryBatch? @relation(fields: [relatedBatchId], references: [id], onDelete: Cascade)

  @@index([shopId, isRead])
  @@index([shopId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  shopId      String
  userId      String?
  action      String   // LOGIN, STOCK_ADD, SALE_CREATE, RETURN_PROCESS, WASTAGE_WRITE_OFF, SETTINGS_UPDATE
  entityType  String
  entityId    String?
  detailsJson String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
}
